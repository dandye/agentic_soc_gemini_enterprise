# Per-environment variable template for multi-target deployments.
#
# Copy to `terraform/environments/<name>.tfvars` (for example `dev.tfvars` or
# `demo.tfvars`, all git-ignored) and pass `env=<name>` to `just`:
#   export TF_VAR_gti_api_key="..."
#   TFSTATE_BUCKET="<YOUR_TFSTATE_BUCKET>"
#   just governance-init bucket="$TFSTATE_BUCKET" prefix="agentic-soc-governance/<name>"
#   just governance-plan env="<name>"
#   terraform -chdir=terraform apply -var-file="environments/<name>.tfvars"
#
# If two stacks share a single GCP project, give each environment a distinct
# `resource_prefix` (for example `"agw-secops-dev"` and `"agw-secops-demo"`) and
# a distinct `sgp_dns_zone_suffix`.

project_id            = "<YOUR_PROJECT_ID>"
org_id                = "<YOUR_ORG_ID>"
chronicle_customer_id = "<YOUR_CHRONICLE_CUSTOMER_ID>"
chronicle_region      = "us"
region                = "us-central1"
resource_prefix       = "agw-secops"

# Scale idle Reasoning Engines to zero ($0/hr idle memory; ~10-25s cold start).
# Warm up before live demos with `just governance-smoke-test`, or set to 1 for
# always-warm instances (~$24/mo per engine).
min_instances = 0
# max_instances = null

# Optional Gemini Enterprise integration (defaults keep shared apps untouched)
ge_engine_id    = "<YOUR_GE_ENGINE_ID>"
ge_location     = "global"
bind_ge_app     = false
create_ge_agent = false

# Gemini 3+ models on global Vertex AI endpoint
orchestrator_model = "gemini-3.1-pro-preview"
tier2_model        = "gemini-3.1-pro-preview"
specialist_model   = "gemini-3.5-flash"
model_location     = "global"

# Governance enforcement modes
authz_enforcement_mode       = "ENFORCED"
enable_model_armor           = true
model_armor_enforcement_type = "INSPECT_AND_BLOCK"
model_armor_confidence_level = "HIGH"
enable_semantic_governance   = true
sgp_enforcement_mode         = "ENFORCED"
