# ============================================================================
# Agentic SOC Gemini Enterprise Agent Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Variables are organized by deployment stage
# ============================================================================

# ----------------------------------------------------------------------------
# STAGE 1: Prerequisites (Set BEFORE deployment)
# ----------------------------------------------------------------------------
# These are required by `just agent-engine-deploy`

# Google Cloud Project Configuration
GCP_PROJECT_ID=your-project-id
GCP_PROJECT_NUMBER=123456789012
GCP_LOCATION=us-central1
GCP_STAGING_BUCKET=gs://your-staging-bucket
GCP_ARTIFACT_BUCKET=your-artifact-bucket

# Chronicle SIEM Configuration
CHRONICLE_PROJECT_ID=your-gcp-project-id
CHRONICLE_CUSTOMER_ID=your-customer-uuid
CHRONICLE_SERVICE_ACCOUNT_PATH=/path/to/service-account.json

# SOAR Platform Configuration
SOAR_URL=https://your-instance.siemplify-soar.com:443
SOAR_API_KEY=your-soar-api-key

# Google Threat Intelligence (VirusTotal)
GTI_API_KEY=your-virustotal-api-key

# ChatOps master switch: the feature is DISABLED by default pending a
# redesign of the human-approval flow (see issues #85-#90). When unset,
# agents do not register ChatOps tools, senders refuse to deliver cards,
# and the Cloud Run handlers return 503. Set to true only to re-enable
# deliberately (e.g. isolated eval environments).
# CHATOPS_ENABLED=false

# ChatOps Webhook Configuration (Google Chat, Slack, etc.)
WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/SPACE_ID/messages?key=KEY&token=TOKEN
# Secret used for signing interactive button payloads (Generate a secure random string)
CHRONICLE_CHATOPS_SECRET=your-secure-chatops-secret

# ChatOps delivery mode (issue #62): "webhook" (default) posts via the
# incoming webhook with openLink buttons; "chat_app" posts as the registered
# Google Chat App so button clicks execute in the background (no browser tab).
# Run `python manage.py chatops registration-guide` for the one-time setup.
# CHATOPS_MODE=chat_app
# Space the Chat App posts to (chat_app mode), e.g. spaces/AAAA1234
# CHAT_SPACE=spaces/your-space-id
# Project number: audience for verifying Google Chat interaction event JWTs
# GCP_PROJECT_NUMBER=123456789012
# Cloud Run URL of the deployed Chat App handler (also the worker OIDC audience)
# CHATOPS_SERVICE_URL=https://chatops-chat-app-xyz.a.run.app
# Cloud Tasks queue decoupling clicks from Agent Engine latency (defaults shown)
# CHATOPS_TASKS_QUEUE=chatops-actions
# CHATOPS_TASKS_LOCATION=us-central1
# Service account with run.invoker on the handler; Cloud Tasks attaches its OIDC token
# CHATOPS_INVOKER_SA=chatops-invoker@your-project-id.iam.gserviceaccount.com
# Comma-separated emails allowed to approve actions; unset = any space member
# CHATOPS_APPROVER_EMAILS=lead@example.com,oncall@example.com
# Per-action Agent Engine query budget in seconds (default 540)
# CHATOPS_AGENT_TIMEOUT=540

# RAG Corpus Configuration
# Format: projects/PROJECT_ID/locations/LOCATION/ragCorpora/CORPUS_ID
# (Format is validated during deployment)
RAG_CORPUS_ID=projects/your-project-id/locations/us-central1/ragCorpora/1234567890

# Elasticsearch Grounding Configuration (Alternative to RAG Corpus)
ELASTICSEARCH_GROUNDING_ENABLED=False
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_API_KEY=your-api-key
# ELASTICSEARCH_USER=elastic
# ELASTICSEARCH_PASSWORD=your-password
ELASTICSEARCH_INDEX=agentic-soc-runbooks
# Explicit timeout (seconds) for HTTP calls in management CLIs and ChatOps
# (issue #64). Webhook path uses CHATOPS_HTTP_TIMEOUT (default 30).
# HTTP_REQUEST_TIMEOUT=60

# TLS certificate verification for Elasticsearch clients (default: false, for
# self-signed dev certs). Set true for CA-signed endpoints.
# ELASTICSEARCH_VERIFY_CERTS=true


# ----------------------------------------------------------------------------

# Optional Configuration (Has sensible defaults)
# ----------------------------------------------------------------------------
# Only uncomment and set these if you need to override defaults

#
# Model Tiering & Quota Optimization
#
# Tier 1 (Critical Reasoning / Orchestrator): High-level planning and hypothesis synthesis
# ORCHESTRATOR_MODEL=gemini-3.7-flash
#
# Tier 2 (Domain Specialists): Deep domain reasoning and playbook execution
# CTI_RESEARCHER_MODEL=gemini-3.7-flash
# DETECTION_ENGINEER_MODEL=gemini-3.7-flash
# THREAT_HUNTER_MODEL=gemini-3.7-flash
# TIER2_RESPONDER_MODEL=gemini-3.7-flash
#
# Tier 3 (Procedural Triage): High-volume alert queue processing and rapid lookups
# TIER1_ANALYST_MODEL=gemini-2.5-flash-lite

# GCP_VERTEXAI_ENABLED=True
# CHRONICLE_REGION=us
# DEBUG=False
# RAG_SIMILARITY_TOP_K=10
# RAG_DISTANCE_THRESHOLD=0.6

# OpenTelemetry Instrumentation (Tracing & Logging)
# Enables Vertex AI Agent Engine telemetry and trace propagation
# GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=True
# Captures prompt inputs and responses inside generated traces
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=True

# GTI Response Caching (Latency Optimization)
# Enables in-memory caching for GTI API responses to reduce latency and API calls
# Defaults shown below are applied automatically in Agent Engine deployments
GTI_CACHE_ENABLED=True

# IOC Cache TTLs (in seconds)
GTI_CACHE_FILE_TTL=86400              # File hash lookups: 24 hours (hashes don't change)
GTI_CACHE_IP_TTL=43200                # IP lookups: 12 hours (IPs don't change sporadically)
GTI_CACHE_DOMAIN_TTL=1800             # Domain lookups: 30 minutes (moderate change rate)
GTI_CACHE_URL_TTL=1800                # URL lookups: 30 minutes (moderate change rate)

# Threat Intelligence Cache TTLs (in seconds)
GTI_CACHE_THREAT_ACTOR_TTL=86400      # Threat actors: 24 hours (stable)
GTI_CACHE_MALWARE_FAMILY_TTL=86400    # Malware families: 24 hours (stable)
GTI_CACHE_CAMPAIGN_TTL=43200          # Campaigns: 12 hours (fairly stable)
GTI_CACHE_REPORT_TTL=43200            # Intelligence reports: 12 hours (fairly stable)
GTI_CACHE_COLLECTION_TTL=43200        # Collections: 12 hours (covers all collection types)
GTI_CACHE_THREAT_PROFILE_TTL=86400    # Threat profiles: 24 hours (stable)
GTI_CACHE_HUNTING_RULESET_TTL=86400   # Hunting rulesets: 24 hours (stable)

# Cache size limits (number of entries per category)
GTI_CACHE_MAX_SIZE=250                # Conservative: ~35-60 MB total across all caches
# GTI_CACHE_MAX_SIZE=500                # Moderate: ~70-120 MB total
# GTI_CACHE_MAX_SIZE=1000               # Generous: ~140-250 MB total

# RAG operations use GCP_LOCATION by default. Only set this if you need a
# different location for RAG (e.g., us-central1 requires allowlist - us-east4 recommended)
# RAG_GCP_LOCATION=us-east4

# ----------------------------------------------------------------------------
# Agent Engine Configuration
# ----------------------------------------------------------------------------
# Agent module to deploy (options: soc_agent, soc_agent_flash, soc_agent_tier1, soc_agent_cti)
# - soc_agent: Gemini 2.5 Pro (slower, more capable, general SOC operations)
# - soc_agent_flash: Gemini 2.5 Flash (faster, lower cost, general SOC operations)
# - soc_agent_tier1: Gemini 2.5 Flash with Tier 1 SOC Analyst persona (alert triage focus)
# - soc_agent_cti: Gemini 2.5 Flash with CTI Researcher persona (threat intelligence focus)
# Set via: AGENT_MODULE=soc_agent_flash just agent-engine-deploy
# Or use convenience targets: just agent-engine-deploy-pro, just agent-engine-deploy-tier2
# AGENT_MODULE=soc_agent


# ----------------------------------------------------------------------------
# STAGE 2: Deployment Outputs (Auto-populated by `just agent-engine-deploy`)
# ----------------------------------------------------------------------------
# AGENT_ENGINE_RESOURCE_NAME=projects/123/locations/us-central1/reasoningEngines/456

# ----------------------------------------------------------------------------
# STAGE 3: Gemini Enterprise Agent Platform Integration
# ----------------------------------------------------------------------------
# PREREQUISITE: # Renamed from AGENTSPACE_* in the Gemini Enterprise rebrand; legacy names
# still work. Run: python manage.py env migrate
GEM_ENT_APP_ID must be created before registration
# Option 1: Create manually via Google Cloud Console (see README step 6)
# Option 2: Auto-create with `python manage.py agentspace create-app`
# GEM_ENT_APP_ID=your-app-id

# Optional Gemini Enterprise Agent Platform hierarchy (only set if customizing)
# GEM_ENT_COLLECTION=default_collection
# GEM_ENT_ASSISTANT=default_assistant

# OUTPUT: Auto-populated by `just agentspace-register`
# GEM_ENT_AGENT_ID=your-agent-id

# ----------------------------------------------------------------------------
# STAGE 4: OAuth Outputs (Auto-populated by `just oauth-setup`)
# ----------------------------------------------------------------------------
# OAUTH_AUTH_ID=your-auth-id
# OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# OAUTH_TOKEN_URI=https://oauth2.googleapis.com/token

# ----------------------------------------------------------------------------
# Neo4j Graph Database
# ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ----------------------------------------------------------------------------
# AlloyDB for PostgreSQL (Detection Reports & Telemetry Grounding)
# ----------------------------------------------------------------------------
ALLOYDB_GROUNDING_ENABLED=True
ALLOYDB_HOST=localhost
ALLOYDB_PORT=5432
ALLOYDB_DATABASE=secops
ALLOYDB_USER=postgres
ALLOYDB_PASSWORD=password
# Optional: Google Cloud AlloyDB Instance URI for Connector
# ALLOYDB_INSTANCE_URI=projects/PROJECT_ID/locations/REGION/clusters/CLUSTER_ID/instances/INSTANCE_ID
# ALLOYDB_SSLMODE=prefer
